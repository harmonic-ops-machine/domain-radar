# Neon Serverless Postgres (pooled URL for Vercel runtime)
DATABASE_URL="postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Neon Direct / Unpooled URL (required for drizzle-kit migrations & scripts/seed-100k.ts)
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Bearer token protecting /api/cron/* and /api/signals/import
# Vercel Pro: vercel.json runs /api/cron/probe every 15m (*/15 * * * *) and /api/cron/patterns every 6h (0 */6 * * *)
# Vercel Hobby: change vercel.json crons to daily (0 2 * * *) or trigger /api/cron/probe every 15m via an external scheduler with Authorization: Bearer <CRON_SECRET>
CRON_SECRET="replace-with-32-byte-random-secret"
